{
  "name": "BloodLink",
  "short_name": "BloodLink",
  "description": "Find nearby blood donors in minutes.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#FFF1EC",
  "theme_color": "#FFF1EC",
  "icons": [
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "shortcuts": [
    { "name": "Post a blood request", "short_name": "Post", "url": "/requests/new", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Dashboard", "url": "/dashboard", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}

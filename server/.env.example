# Copy this file to .env and fill in the values.

PORT=5000

# Local MongoDB, or your MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/bloodlink

# Any long random string. Never commit the real one.
JWT_SECRET=change-me-to-a-long-random-string

# Where the React app runs (for CORS)
CLIENT_URL=http://localhost:5173

# How many proxies sit in front of the server, so rate limits see visitors' real IPs.
# Detected automatically on Render (1). Set it yourself on other hosts behind a proxy.
# TRUST_PROXY=1

# Optional: push notifications when the app is closed.
# Generate with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@example.com

# One-time codes (sign-up confirmation and code login) are texted through MSG91.
# Both values come from your MSG91 dashboard; the template must be DLT-approved.
# Leave them empty and codes are switched off (sign-up then skips confirmation).
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Optional: country code added to 10-digit numbers (default 91, India)
# MSG91_COUNTRY_CODE=91

# LOCAL TESTING ONLY: true prints codes in the server log and shows them on screen
# instead of texting them. Ignored once MSG91 is set up.
# Never set this on a live site, or anyone can log in as anyone.
OTP_DEV_SHOW_CODE=false

# Optional: centre point for demo donors created by `npm run seed`
SEED_LAT=28.6139
SEED_LNG=77.2090
